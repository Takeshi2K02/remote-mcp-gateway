APP_NAME=
APP_ENV=
APP_HOST=
APP_PORT=

# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL. Defaults to INFO
# when unset or unrecognised. Read from the environment directly rather than
# via Settings so logging works even if Settings validation fails.
LOG_LEVEL=INFO

# Azure SQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=

# Microsoft Entra ID
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

ENTRA_CLIENT_SECRET=

SQL_QUERY_TIMEOUT_SECONDS=30
SQL_MAX_ROWS=1000

APP_JWT_SECRET_KEY=
APP_JWT_ALGORITHM=HS256
APP_JWT_EXPIRE_MINUTES=60
FRONTEND_BASE_URL=

BACKEND_BASE_URL=
OAUTH_ISSUER=
MCP_ENDPOINT_URL=

# MCP Allowed Hosts and Origins (comma-separated list of hosts/origins, and boolean to enable/disable protection)
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_ENABLE_DNS_REBINDING_PROTECTION=

# Local/dev convenience only: runs `alembic upgrade head` on app startup.
# Must stay unset/false anywhere migrations are gated by CI/CD (staging,
# production) - see .github/workflows/backend-ci.yml's run-migrations job
# and docs/DEPLOYMENT.md.
AUTO_MIGRATE_ON_STARTUP=false

# Application
SECRET_KEY=